{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "types": [
      "node"
    ],
    "paths": {
      "paper-ink": [
        "./packages/paper-ink/src/index.ts"
      ],
      "paper-ink/icons": [
        "./packages/paper-ink/src/icons/index.ts"
      ]
    }
  },
  "include": [
    "packages/*/src",
    "apps/*/src",
    "apps/*/vite.config.ts",
    "tests",
    "*.config.ts"
  ]
}
