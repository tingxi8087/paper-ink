{
  "name": "paper-ink-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.22.0",
  "scripts": {
    "dev": "pnpm --filter @paper-ink/website dev",
    "build": "pnpm --filter paper-ink build && pnpm --filter @paper-ink/cli build && pnpm --filter @paper-ink/website build",
    "typecheck": "tsc --noEmit",
    "test": "pnpm build:registry && vitest run && node --test packages/cli/test/*.test.mjs",
    "test:browser": "playwright test",
    "check:size": "node scripts/check-size.mjs",
    "check:package": "node scripts/check-package.mjs",
    "build:registry": "pnpm --filter @paper-ink/cli build",
    "cli": "node packages/cli/dist/index.mjs",
    "check:cli": "pnpm --filter paper-ink build && pnpm build:registry && node scripts/check-cli.mjs"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0",
    "jsdom": "^26.0.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.0.0",
    "@testing-library/jest-dom": "^6.0.0",
    "@playwright/test": "^1.56.0",
    "esbuild": "^0.25.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
